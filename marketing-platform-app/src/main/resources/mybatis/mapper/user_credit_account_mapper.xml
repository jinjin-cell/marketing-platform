<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.persistent.dao.IUserCreditAccountDao">

    <resultMap id="UserCreditAccountMap" type="cn.qijiv.infrastructure.persistent.po.UserCreditAccountPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="available_amount" property="availableAmount"/>
        <result column="account_status" property="accountStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.qijiv.infrastructure.persistent.po.UserCreditAccountPO">
        INSERT INTO user_credit_account
            (user_id, total_amount, available_amount, account_status)
        VALUES
            (#{userId}, #{totalAmount}, #{availableAmount}, #{accountStatus})
    </insert>

    <select id="queryUserCreditAccountByUserId" parameterType="cn.qijiv.infrastructure.persistent.po.UserCreditAccountPO" resultMap="UserCreditAccountMap">
        SELECT id, user_id, total_amount, available_amount, account_status, create_time, update_time
        FROM user_credit_account
        WHERE user_id = #{userId}
    </select>

    <update id="updateAddAmount" parameterType="cn.qijiv.infrastructure.persistent.po.UserCreditAccountPO">
        UPDATE user_credit_account
        SET total_amount = total_amount + #{totalAmount},
            available_amount = available_amount + #{availableAmount},
            update_time = NOW()
        WHERE user_id = #{userId}
    </update>

</mapper>

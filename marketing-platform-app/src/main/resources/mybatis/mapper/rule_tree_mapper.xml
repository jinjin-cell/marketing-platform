<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.dao.IRuleTreeDao">

    <resultMap id="RuleTreeMap" type="cn.qijiv.infrastructure.dao.po.RuleTreePO">
        <id column="id" property="id"/>
        <result column="tree_id" property="treeId"/>
        <result column="tree_name" property="treeName"/>
        <result column="tree_desc" property="treeDesc"/>
        <result column="tree_node_rule_key" property="treeNodeRuleKey"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryRuleTreeByTreeId" parameterType="java.lang.String" resultMap="RuleTreeMap">
        SELECT id, tree_id, tree_name, tree_desc, tree_node_rule_key, create_time, update_time
        FROM rule_tree
        WHERE tree_id = #{treeId}
        LIMIT 1
    </select>

</mapper>

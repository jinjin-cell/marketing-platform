<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.persistent.dao.IAwardDao">

    <resultMap id="AwardMap" type="cn.qijiv.infrastructure.persistent.po.AwardPO">
        <id column="id" property="id"/>
        <result column="award_id" property="awardId"/>
        <result column="award_key" property="awardKey"/>
        <result column="award_config" property="awardConfig"/>
        <result column="award_desc" property="awardDesc"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryAwardList" resultMap="AwardMap">
        SELECT award_id, award_key, award_config, award_desc, create_time, update_time
        FROM award
    </select>

    <select id="queryAwardConfigByAwardId" resultType="java.lang.String">
        SELECT award_config
        FROM award
        WHERE award_id = #{awardId}
    </select>

    <select id="queryAwardKeyByAwardId" resultType="java.lang.String">
        SELECT award_key
        FROM award
        WHERE award_id = #{awardId}
    </select>

</mapper>

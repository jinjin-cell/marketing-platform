<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.elasticsearch.IElasticSearchUserRaffleOrderDao">

    <resultMap id="userRaffleOrderResultMap" type="cn.qijiv.infrastructure.elasticsearch.po.UserRaffleOrderPO">
        <result column="_user_id" property="userId"/>
        <result column="_activity_id" property="activityId"/>
        <result column="_activity_name" property="activityName"/>
        <result column="_strategy_id" property="strategyId"/>
        <result column="_order_id" property="orderId"/>
        <result column="_order_time" property="orderTime"/>
        <result column="_order_state" property="orderState"/>
        <result column="_create_time" property="createTime"/>
        <result column="_update_time" property="updateTime"/>
    </resultMap>

    <sql id="columns">
        "_user_id", "_activity_id", "_activity_name", "_strategy_id", "_order_id",
        "_order_time", "_order_state", "_create_time", "_update_time"
    </sql>

    <select id="queryUserRaffleOrderList" resultMap="userRaffleOrderResultMap">
        SELECT <include refid="columns"/>
        FROM "big_market.user_raffle_order"
        ORDER BY "_create_time" DESC
        LIMIT 1000
    </select>

    <select id="queryUserRaffleOrderListByUserId" resultMap="userRaffleOrderResultMap">
        SELECT <include refid="columns"/>
        FROM "big_market.user_raffle_order"
        WHERE "_user_id" = #{userId}
        ORDER BY "_create_time" DESC
        LIMIT 1000
    </select>

</mapper>

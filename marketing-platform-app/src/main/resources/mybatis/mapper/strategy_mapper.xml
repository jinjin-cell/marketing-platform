<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.persistent.dao.IStrategyDao">

    <resultMap id="StrategyMap" type="cn.qijiv.infrastructure.persistent.po.StrategyPO">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="strategy_desc" property="strategyDesc"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryStrategy" parameterType="java.lang.Long" resultMap="StrategyMap">
        SELECT strategy_id
        FROM strategy
        WHERE strategy_id = #{strategyId}
    </select>

</mapper>

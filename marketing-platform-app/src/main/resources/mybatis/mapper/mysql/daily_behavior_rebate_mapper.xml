<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.dao.IDailyBehaviorRebateDao">

    <resultMap id="DailyBehaviorRebateMap" type="cn.qijiv.infrastructure.dao.po.DailyBehaviorRebatePO">
        <id column="id" property="id"/>
        <result column="behavior_type" property="behaviorType"/>
        <result column="rebate_desc" property="rebateDesc"/>
        <result column="rebate_type" property="rebateType"/>
        <result column="rebate_config" property="rebateConfig"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryDailyBehaviorRebateByBehaviorType" resultMap="DailyBehaviorRebateMap">
        SELECT id, behavior_type, rebate_desc, rebate_type, rebate_config,
               state, create_time, update_time
        FROM daily_behavior_rebate
        WHERE behavior_type = #{behaviorType}
          AND state = 'open'
    </select>

</mapper>

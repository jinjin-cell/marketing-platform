<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qijiv.infrastructure.dao.IUserCreditOrderDao">

    <resultMap id="UserCreditOrderMap" type="cn.qijiv.infrastructure.dao.po.UserCreditOrderPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="order_id" property="orderId"/>
        <result column="trade_name" property="tradeName"/>
        <result column="trade_type" property="tradeType"/>
        <result column="trade_amount" property="tradeAmount"/>
        <result column="out_business_no" property="outBusinessNo"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!--suppress SqlResolve -->
    <insert id="insert" parameterType="cn.qijiv.infrastructure.dao.po.UserCreditOrderPO">
        INSERT INTO user_credit_order
            (user_id, order_id, trade_name, trade_type, trade_amount, out_business_no)
        VALUES
            (#{userId}, #{orderId}, #{tradeName}, #{tradeType}, #{tradeAmount}, #{outBusinessNo})
    </insert>

    <!--suppress SqlResolve -->
    <select id="queryUserCreditOrderByOutBusinessNo" parameterType="cn.qijiv.infrastructure.dao.po.UserCreditOrderPO" resultMap="UserCreditOrderMap">
        SELECT id, user_id, order_id, trade_name, trade_type, trade_amount, out_business_no, create_time, update_time
        FROM user_credit_order
        WHERE user_id = #{userId}
          AND out_business_no = #{outBusinessNo}
        LIMIT 1
    </select>

</mapper>
